# Comma-separated list of frontend origins allowed to call this API.
# Local development default:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example (your Vercel URL, no trailing slash):
# CORS_ORIGINS=https://your-prism-app.vercel.app

# Optional: regex for extra origins such as Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://your-prism-app-.*\.vercel\.app

# No database credentials are needed. PRISM processes uploads in memory only.
